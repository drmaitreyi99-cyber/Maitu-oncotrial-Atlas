# Local demo mode runs without these values.
# The interface labels sample records and will not invent missing trial numbers.
NEXT_PUBLIC_DEMO_MODE=true

# Optional contact information used by the GitHub Actions discovery script.
NCBI_TOOL=maitu_oncotrial_atlas
NCBI_EMAIL=

# Conference adapters remain disabled unless you have a licensed source.
ENABLE_CONFERENCE_ADAPTERS=false
